# انسخ الملف ده باسم .env وعبّي القيم. ماترفعش .env على GitHub أبدًا.

# Neon: الرابط "Pooled" (فيه -pooler في اسم الـ host). بيستخدمه السيرفر وقت التشغيل.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Neon: الرابط "Direct" (من غير -pooler). بيستخدمه Prisma للـ migrations بس.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# سلسلة عشوائية طويلة (32 حرف على الأقل). طريقة توليدها:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="غيّر-القيمة-دي-بسلسلة-عشوائية-طويلة"

PORT=3000
NODE_ENV=development

# مدة صلاحية الـ Access Token بالدقايق، والـ Refresh Token بالأيام
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# الـ origins المسموحة للويب (مفصولة بفاصلة). تطبيقات الموبايل والديسك توب مش بتتأثر بيها.
CORS_ORIGINS=""

# المنطقة الزمنية الافتراضية لتجميع التقارير اليومية
DEFAULT_TZ="Africa/Cairo"
